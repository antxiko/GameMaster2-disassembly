# Puntos de entrada del banco 1 (se ejecuta en 0x6000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador 0x408D, que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x606A   # p01:605C entrada 0 de la tabla de 0x605F (despachador en 0x605C)
0x60E4   # p01:605C entrada 1 de la tabla de 0x605F (despachador en 0x605C)
0x623B   # p00:5F28 call
0x626F   # p01:605C entrada 2 de la tabla de 0x605F (despachador en 0x605C)
0x62D3   # p00:5DF4 call
0x632A   # p00:563F call
0x6389   # p00:5645 call
!reubica 0x6395 0x63da 0xf130   # p01:6333 ldir (hl=6395 de=F130 bc=0045)
0x63BF   # a mano, jp 0xF15A desde p00:56E2: bloque p01:6395 (en 0xF130) + 0x2A; en el otro bloque de 0xF130 (p01:63DA) caeria a mitad de instruccion
!reubica 0x63da 0x6468 0xf130   # p01:651C ldir (hl=63DA de=F130 bc=008E)
0x6455   # a mano, 0xF1AB desde p01:64C0: bloque p01:63DA (en 0xF130) + 0x7B
!reubica 0x64c6 0x64dc 0xf230   # p01:6392 ldir (hl=64C6 de=F230 bc=0016)
0x64DC   # a mano, p01:64C7: ld ix,0x64DC + call CALSLT
0x651F   # a mano, p01:640E: ld ix,0x651F + jp CALSLT
0x656C   # p00:4C31 call
0x665E   # p00:5E07 jp cc
0x6669   # p00:5664 jp
0x66B0   # p01:669B entrada 0 de la tabla de 0x669E (despachador en 0x669B)
