# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6065 sin_juego Z si no se reconocio el juego (0xF281 = 0xFF)
L 0x623B modify_mode el MODIFY MODE MENU: limpia y pinta (gemela de p02:8BFC)
L 0x62CC menu_dos menu de 2 opciones (p01:750E)
L 0x62D3 borra_sprites borra la tabla de sprites (0x3880, 0x200 bytes)
L 0x62DD teclado_a_nibble pasa la tecla del bufer (0x920B) a un nibble
L 0x6304 teclado_a_nibble_b pasa las teclas del bufer (0x920B) a un byte
L 0x632A engancha_al_juego copia p01:6395 a 0xF130 y cambia el gancho del juego por el suyo
L 0x6353 busca_gancho busca en la copia del INIT del juego el `ld (0xFD9B),hl` (9B FD)
L 0x6371 copia_del_juego copia BC bytes de HL del cartucho del juego (RDSLT) a DE
L 0x6389 copia_f230 copia p01:64C6 a 0xF230 (22 bytes)
L 0x6468 vuelve_tras_menu devuelve la RAM a la pagina 2 y sigue segun 0xF10A
L 0x6534 silencia_psg pone a cero los tres volumenes del PSG (y el SCC del juego si lo tiene)
L 0x656C guarda_volumenes guarda los tres volumenes del PSG en 0xF100
L 0x65A1 congela congela el juego: silencio y espera la tecla
L 0x65C6 bio_borra_estado pone a cero 0xE006 y 0xE004 (gemela de p05:9924)
L 0x65EA devuelve_volumenes devuelve los tres volumenes del PSG (y el SCC)
L 0x662E lee_teclas las teclas del Game Master (SNSMAT 1, 6 y 7) en 0xF10D: C = las recien pulsadas
L 0x66A9 pon_opcion copia 0xF111 a 0xE000
L 0x672D bancos_9_10 el cartucho en la pagina 2 y los bancos 9-10
L 0x673F bancos_2_3_y_ram los bancos 2-3 y devuelve la RAM (0xF2A0) a la pagina 2
L 0x6756 espera_tecla espera una tecla (CHSNS) HL x B veces
L 0x6762 pinta_paleta_prueba pinta los 16 colores en 0x3800 y 0x3A80
L 0x6774 pinta_16_colores pinta 16 casillas con los colores 1-15
L 0x67F3 truco_vidas las vidas: la rutina del juego de la tabla de p01:6CA6
L 0x6804 truco_fase la fase: la rutina del juego de la tabla de p01:6CD7
L 0x6819 truco_propio llama por CALSLT a la rutina del juego de 0xF294
L 0x6827 busca_en_tabla_y_salta busca 0xF281 en la tabla [codigo, direccion] de HL y salta
L 0x683A busca_en_tabla busca 0xF281 en la tabla [codigo, direccion] de HL
L 0x684A menu_ranking la pantalla del RANKING
L 0x68D3 menu_ocho menu de 8 opciones (p01:750E)
L 0x68DA borra_3 pone a cero 3 bytes en HL
L 0x68E1 hay_ranking Z si el juego no tiene ranking (0xF290, 0xF286)
L 0x690B ranking_quita_1_y_2 quita las marcas 1 y 2 del ranking
L 0x6912 ranking_quita_marca quita la marca A de las 10 filas del ranking (0x9257)
L 0x6926 pinta_ranking pinta la cabecera y las filas del ranking
L 0x69AD ranking_entra mete la puntuacion en el ranking
L 0x69BE ranking_busca_marca busca la marca A en el ranking
L 0x6A14 ranking_ordena ordena el ranking
L 0x6A2B ranking_compara compara dos filas del ranking
L 0x6A59 ranking_mueve mueve una fila del ranking
L 0x6AA0 ranking_nombre pide el nombre para el ranking
L 0x6B32 rellena_vram rellena la VRAM con A (letra a letra si la pantalla es de texto)
L 0x6B48 copia_a_vram copia BC bytes de HL a la VRAM DE (letra a letra si es de texto)
L 0x6B62 ranking_edita edita el nombre del ranking
L 0x6C38 fila_de_ranking HL = la fila A del ranking (0x9257, 9 bytes)
L 0x6C46 puntos_de_ranking HL = los puntos de la fila A (0x9239, 3 bytes)
L 0x6D2F truco_6d2f pone 0xF29A en la variable del juego
L 0x6D41 truco_6d41 calcula el valor que se escribe en el juego (p01:706C)
L 0x6DB1 busca_juego_6dc9 busca el juego (0xF280) en la tabla de p01:6DC9
L 0x6F70 pon_valor escribe 0xF29C en la variable del juego (0xF28A)
L 0x706C divide_a_menos_1 DE = (A - 1) / C y HL = el resto (division de 16 bits, bit a bit)
L 0x7071 divide DE / BC: cociente en DE y resto en HL (gemela de p05:9430)
L 0x708B borra_pantalla_b borra la tabla de nombres y esconde los sprites
L 0x709D reconoce_juego reconoce el juego del otro cartucho y prepara su ficha
L 0x70AA lee_cabecera_juego lee la cabecera de 0x4028 del juego y sus opciones
L 0x7112 ficha_del_juego busca la ficha del juego (p00:44BE) y la copia a 0xF280
L 0x7136 busca_ficha copia la ficha por defecto (p00:45D0) y busca la del juego por su suma
L 0x71D7 rc_751_o_752 compara el RC del juego (0xE000, al reves) con 0x751 y 0x752
L 0x7251 hl_mas_a HL = HL + A
L 0x7256 de_mas_a DE = DE + A
L 0x725B pon_color MSX2: el color B de la paleta con D y E (R#16 y puerto 2)
L 0x7275 paleta_msx2 MSX2: los 16 colores de p01:728E
L 0x727A paleta_bio MSX2: los 16 colores de p05:82D7 (gemela de p05:82C3)
L 0x727D paleta_desde MSX2: los 16 colores de HL (gemela de p05:82C6)
L 0x72AE paleta_lista MSX2: colores de una lista [color, d, e] que acaba en 0xFF
L 0x72BC registros_vdp los 8 registros del VDP de p01:72E2 y, en MSX2, R#23 y R#9
L 0x72EA borra_nombres borra la tabla de nombres y esconde los sprites (0xD0 en 0x3B00)
L 0x72FC rellena_tercios FILVRM en los tres tercios de la pantalla
L 0x730D copia_tercios LDIRVM en los tres tercios de la pantalla
L 0x7323 descomprime_tercios descomprime HL en los tres tercios de la pantalla
L 0x7336 descomprime_con_direccion descomprime a la VRAM de la palabra de HL
L 0x733A descomprime descomprime HL a la VRAM DE: n & 0x7F repeticiones o copias
L 0x736A vram_escribe_en SETWRT (o NSTWRT en MSX2) en HL
L 0x737B despacha salta a la palabra A de la tabla pegada detras del `call`
L 0x738B pinta_texto_en pinta el texto de HL en la VRAM DE
L 0x738F pinta_texto pinta el texto de HL: [direccion de VRAM] y letras; 0xFE otra direccion, 0xFF acaba
L 0x73AB pinta_texto_grafico pinta el texto en modo grafico
L 0x73B5 modo_de_texto Z si la pantalla es de texto (0xFCAF < 5)
L 0x73E1 rellena_ventana rellena una ventana de B filas por C columnas con A
L 0x7467 hl_otra_mitad H xor 0x80
L 0x746C binario_a_bcd HL a BCD en DE
L 0x747D bcd_a_binario A en BCD a binario
L 0x748F borra_ventana borra la ventana de 0x9237
L 0x7499 p02_8000_si si 0xF112: p02:8000 con el cartucho en la pagina 2
L 0x749E p02_8000 p02:8000 con el cartucho en la pagina 2 y vuelta a la RAM
L 0x74BA p02_80e4_si si 0xF112: p02:80E4
L 0x74BF p02_80e4 p02:80E4 con el cartucho en la pagina 2 y vuelta a la RAM
L 0x74D6 borra_segun_modo borra la pantalla segun el modo
L 0x74FD cartucho_en_8000 pone el cartucho (0xF103) en la pagina 2
L 0x750E menu menu de B opciones con el cursor A: devuelve la elegida
L 0x75E2 borra_teclado borra el bufer de teclas del menu (0x920B)
L 0x7600 cursor_apaga quita el cursor
L 0x760A cursor_apaga_b quita el cursor (gemela de p03:A74F)
L 0x7633 cursor_pinta pinta el cursor (':' o el de MSX2)
L 0x7642 cursor_borra borra el cursor
L 0x7646 pon_letra escribe A en la VRAM HL guardando los registros
L 0x7652 pon_letra_b escribe A en la VRAM HL (WRTVRM o en modo grafico)
L 0x766D opcion_cero si no hay opcion elegida, vuelve al menu
L 0x7676 menu_con_esc menu: espacio elige, ESC sale
L 0x7690 menu_vertical menu de B opciones: cursores arriba y abajo, espacio elige
L 0x76AF menu_prepara prepara el menu: opciones, posicion y cursor
L 0x76C1 menu_cursor mueve el cursor con las flechas (0x1E arriba, 0x1F abajo)
L 0x76F6 menu_limpia quita el cursor y borra el teclado
L 0x7707 comprime comprime 0x8802 en 0x8002 (lo contrario de p01:733A)
L 0x7790 fin_de_8882 compara HL con 0x8882
L 0x7834 lee_vram_tercios LDIRMV de los tres tercios (0x2000 de paso)
L 0x788E copia_vram_tercios LDIRVM de los tres tercios (0x2000 de paso)
L 0x78A0 borra_por_modo borra la pantalla segun el modo de 0xF2A1
L 0x78BA letra_grafica pinta una letra en modo grafico
L 0x78D0 posicion_grafica la posicion en modo grafico de la letra
L 0x790D dibuja_letra dibuja la letra A con la fuente de p00:4837
L 0x7969 de_otra_mitad D xor 0x80
L 0x796E letra_grafica_b posicion y letra en modo grafico
L 0x7973 menu_principal el menu del Game Master: engancha H.TIMI y pinta
