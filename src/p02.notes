# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8000 guarda_pantalla guarda la pantalla del juego antes del menu (segun el modo de 0xF3DF/0xF3E0)
L 0x8080 rellena_vram_128k pone a 0 BC bytes de la VRAM HL (128 KB)
L 0x8099 vram_alta_escribe H xor 0x80 y NSTWRT: la otra mitad de los 128 KB de VRAM
L 0x80A0 vram_pagina H y el puerto de datos del VDP para la pagina de VRAM que se ve (0xF3E1)
L 0x80C6 lee_vram_128k lee BC bytes de la VRAM HL (128 KB) a DE
L 0x80DD vram_alta_lee H xor 0x80 y NSETRD
L 0x80E4 devuelve_pantalla devuelve la pantalla del juego guardada (segun el modo de 0xF2A1)
L 0x8143 escribe_vram_128k escribe BC bytes de DE en la VRAM HL (128 KB)
L 0x815A registros_vdp_6020 los registros del VDP de p01:6020
L 0x815F registros_vdp_menu los 8 registros del VDP de p02:8170
L 0x8178 sprites_apagados R#8 con el bit 1: sin sprites
L 0x8183 sprites_encendidos R
L 0x837F mi_slot A = el slot de la pagina 1 (RSLREG y EXPTBL): el del propio cartucho (gemela de p00:5752)
L 0x8398 lee_palabra_del_juego DE = la palabra HL del cartucho del juego (RDSLT en 0xF104) (gemela de p00:576B)
L 0x839C lee_palabra_slot DE = la palabra HL del slot C (RDSLT) (gemela de p00:576F)
L 0x83A0 lee_byte_slot D = el byte HL del slot C (RDSLT), y avanza HL (gemela de p00:5773)
L 0x83AC salta_a_da00 copia p02:83BA a 0xDA00 (0xCD bytes) y salta alli
L 0x84B0 ventana_menu las esquinas de la ventana del menu (0x9235, 0x9237) (gemela de p00:5A3B)
L 0x8531 pregunta_si_b pinta la pregunta y espera la respuesta
L 0x853D texto_854c pinta el texto de p02:854C
L 0x8542 texto_855c pinta el texto de p02:855C
L 0x85CF pide_fichero_b abre la ventana de los ficheros y deja elegir
L 0x8633 cabecera_menu_b pinta la cabecera del menu con el juego puesto
L 0x863C pinta_juego_b pinta el numero de juego (0xD301) en hexadecimal
L 0x8644 pinta_numero_de_juego_b pinta el numero de juego (0xD301)
L 0x869C cabecera_screen_b pinta la cabecera SCREEN DATA / GAME DATA
L 0x86A8 cabecera_86de pinta la cabecera de p02:86DE
L 0x86F8 pinta_opcion_b pinta la opcion elegida (0xD136, nibble alto)
L 0x873C pinta_tipo pinta el tipo elegido (0xF10B, nibble bajo) (gemela de p00:5D56)
L 0x8780 texto_search_b pinta 'SEARCH FILE'
L 0x8796 cabecera_87a2 pinta la cabecera de p02:87A2
L 0x88B6 ventana_pequena las esquinas de una ventana (0x9235, 0x9237) (gemela de p00:5F0D)
L 0x893A sram_ordenes_c_d SRAM por CALSLT: las ordenes 0x0C y 0x0D (p04:8000) (gemela de p00:4373)
L 0x899C pregunta_vuelve pregunta y vuelve al menu (gemela de p00:5F70)
L 0x8A26 sin_juego_b Z si no se reconocio el juego (0xD301 = 0xFF)
L 0x8BFC modify_mode el MODIFY MODE MENU: limpia y pinta
L 0x8C8D menu_dos_b menu de 2 opciones (p03:A65F)
L 0x8CED borra_sprites borra la tabla de sprites (0x3880, 0x200 bytes) (gemela de p01:62D3)
L 0x8CF7 teclado_a_nibble_c pasa la tecla del bufer (0xD142) a un nibble
L 0x8D1E teclado_a_byte pasa las teclas del bufer (0xD142) a un byte
L 0x8D44 engancha_al_juego_b copia p02:8D98 a 0xD814 y busca en el INIT del juego el ld (0xFD9B),hl
L 0x8D74 copia_del_juego copia BC bytes de HL del cartucho del juego (RDSLT) a DE (gemela de p01:6371)
L 0x8D8C copia_d170 copia p02:8DE5 a 0xD170 (0x18E bytes): el codigo que corre con el juego
L 0x8EB7 salta_a_ix jp (ix)
L 0x8F2B copia_3_al_reves copia 3 bytes de HL hacia atras en DE (gemela de p00:5A80)
L 0x8F34 compara_3 compara 3 bytes (BCD) de HL y DE (gemela de p00:5A89)
L 0x8F88 silencia_psg_b pone a cero los tres volumenes del PSG (y el SCC del juego si 0xD4D4)
L 0x8FC0 guarda_volumenes guarda los tres volumenes del PSG en 0xF100 (gemela de p01:656C)
L 0x8FF5 congela congela el juego: silencio y espera la tecla (gemela de p01:65A1)
L 0x901A bio_borra_estado pone a cero 0xE006 y 0xE004 (gemela de p05:9924)
L 0x902E devuelve_volumenes_b devuelve los tres volumenes del PSG (0xD12B-0xD12D) y el SCC
L 0x9072 lee_teclas las teclas del Game Master (SNSMAT 1, 6 y 7) en 0xF10D: C = las recien pulsadas (gemela de p01:662E)
L 0x90A2 disco_guarda_partida_b GAME DATA: graba la RAM del juego (crea, escribe, cierra)
L 0x90CE disco_guarda_pantalla SCREEN DATA: graba la RAM y la pantalla
L 0x9116 disco_guarda_vrm graba un fichero .VRM (la VRAM) (gemela de p00:4BA0)
L 0x9143 disco_guarda_ranking_b graba el ranking en disco
L 0x915C disco_guarda_bloque_b graba el bloque de 0xD30C en disco
L 0x9172 disco_carga_partida_b carga GAME DATA del disco
L 0x91B5 disco_carga_pantalla carga SCREEN DATA del disco
L 0x91CD disco_carga_ranking_b carga el ranking del disco
L 0x91E3 disco_carga_bloque_b carga el bloque de 0xD30C del disco
L 0x91F6 disco_graba_c000 graba 0x22 registros de 0x80 bytes desde 0xC000
L 0x920C disco_graba_registro copia 0x80 bytes a 0x8000 y los graba (BDOS 0x26) (gemela de p00:4C8E)
L 0x921F disco_graba_d459 graba 0x78 registros desde 0xD459
L 0x922D disco_graba_d30c graba 3 registros desde 0xD30C - 0x2000
L 0x9242 disco_lee_c000 lee 0x1100 registros a 0xC000
L 0x9250 disco_lee_d459 lee 0x78 registros a 0xD459
L 0x925E disco_lee_d30c lee 3 registros a 0xD30C - 0x2000
L 0x928F disco_lee_pantalla lee la cabecera de pantalla y, si es buena, la VRAM
L 0x9298 disco_lee_vram_bloques lee la VRAM por bloques de 0x80
L 0x92C0 disco_lee_cabecera_pantalla lee 9 bytes: el modo y los 8 registros del VDP
L 0x92E3 pon_registros_vdp escribe E registros del VDP desde HL, empezando por C (gemela de p00:4DFE)
L 0x92EF disco_graba_cabecera_pantalla graba 9 bytes: el modo (0xF3DF) y los registros del VDP
L 0x9336 disco_graba_bload graba la cabecera de BLOAD (0xFE, inicio, fin y ejecucion)
L 0x937E disco_graba_100_de_vram lee 0x100 bytes de la VRAM y los graba (gemela de p00:4F84)
L 0x9381 disco_graba_bc_de_vram lee BC bytes de la VRAM y los graba (gemela de p00:4F87)
L 0x939A entra_al_disco_b intercambia la RAM del juego y desplaza 0xF0FF hacia arriba para el disco
L 0x93B1 sale_del_disco_b espera y devuelve la RAM del juego
L 0x93D0 intercambia_e000_c000 intercambia 0x1100 bytes de 0xE000 y 0xC000
L 0x9421 nombre_de_fichero pone en el FCB (0x982C) el nombre: tipo y numero de juego (gemela de p00:507D)
L 0x943D byte_a_hex escribe A en hexadecimal (dos letras) en HL (gemela de p00:5099)
L 0x944F borra_fcb pone a cero el FCB de 0x982F (gemela de p00:50AB)
L 0x945D hay_disco_b Z si no hay disco (H.PHYD = ret) y 0xD4F9 no lo fuerza
L 0x9482 fcb_prepara registro 0, tamano de registro 1 y bloque actual en el FCB de 0x9848 (gemela de p00:50D6)
L 0x94B1 fcb_registro pone HL como registro aleatorio del FCB (gemela de p00:5105)
L 0x94BE bdos_abre BDOS 0x0F, abrir fichero; si falla, el error 0 (gemela de p00:5112)
L 0x94CE bdos_crea BDOS 0x16, crear fichero; si falla, el error 1 (gemela de p00:5122)
L 0x94DE bdos_cierra BDOS 0x10, cerrar fichero; si falla, el error 2 (gemela de p00:5132)
L 0x94EE bdos_lee BDOS 0x27, leer HL registros; si falla, el error 3 (gemela de p00:5142)
