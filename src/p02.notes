C 0x900E el bit 6
C 0x9011 el bit 5
C 0x9072 la fila 1 del teclado...
C 0x9077 ...a nivel alto...
C 0x9078 ...el bit 7
C 0x907B la fila 6...
C 0x9080 ...a nivel alto...
C 0x9081 ...los bits 1, 5, 6 y 7
C 0x9083 CTRL...
C 0x9087 ...tambien al bit 3
C 0x929B lee el tamano del bloque comprimido
C 0x92A0 el bufer en 0xC000
C 0x92A9 lee el bloque
C 0x92AD y lo descomprime en la VRAM
C 0x92B5 los 128 bytes siguientes de la VRAM
C 0x92BA hasta 0x4000
C 0x92C0 el bufer en 0xC000
C 0x92C8 lee 9 bytes
C 0x92CE los 8 registros del VDP del fichero...
C 0x92D5 ...al VDP
