0xA24F   # p02:8345 call
0xA3EB   # huerfana: de += a (como p03:A3E6 con hl)
0xA40A   # huerfana: paleta del MSX2 (16 colores de p03:A423 por p03:A3F0); la misma rutina esta en p01:725B y p05:8299
0xA443   # huerfana: paleta desde una lista [color, d, e] que acaba en 0xFF
