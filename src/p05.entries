# Puntos de entrada del banco 5 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador 0x408D, que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8000   # p00:5E28 call
!reubica 0x8030 0x8033 0xfd9f   # p05:801E ldir (hl=8030 de=FD9F bc=0003): H.TIMI = jp 0x8033
0x8078   # p06:A289 call
0x808E   # huerfana (fragmento)
0x809C   # huerfana (fragmento)
0x80EA   # huerfana (fragmento)
0x811C   # huerfana: rutina de la biblioteca grafica de p05 (call 0x819C, 0x812F)
0x8163   # huerfana (fragmento)
0x81F2   # huerfana: entrada alternativa (ld c,1 / jr p05:81BB)
0x81F6   # huerfana: entrada alternativa (ld c,1 / jr p05:81C1)
0x81FA   # huerfana (fragmento)
0x8206   # huerfana (fragmento)
0x8248   # huerfana (fragmento)
0x839C   # p06:A137 call
0x8499   # huerfana (fragmento)
0x84DB   # huerfana (fragmento)
0x8538   # huerfana (fragmento)
0x85E5   # huerfana: guarda A en 0xFAF5 y calcula A*8, A*16
0x8631   # huerfana: rutina de dibujo con la tabla de 0xE090
0x86B3   # huerfana (fragmento)
0x86CB   # huerfana: recorre una lista de bytes que acaba en 0xFF. Las dos palabras 0x86CB de p08 (A293, A333) no cuentan: con p08 en 0xA000 esta p07 en 0x8000
0x86EA   # huerfana (fragmento)
0x870E   # huerfana: un caracter de 8x8 por el comando del VDP (p05:8404); gemela p09:8F8F
0x8B5D   # tabla p05:8B1B (MSX1), estado 0
0x8B66   # tabla p05:8B29 (MSX2), estado 0
0x8B6F   # tabla p05:8B1B (MSX1), estado 1
