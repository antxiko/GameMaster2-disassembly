C 0x97DB el mes: 4
C 0x97DE ...16 (los de la segunda)
C 0x97DF el dia: 5
C 0x97E2 otra cifra: 6
C 0x98A6 el mes 0 no vale
C 0x98AB ni mas de 12
C 0x98B1 el dia 0 no vale
C 0x98B6 los dias de cada mes, en la tabla de p05:9978
C 0x98B9 el mes
C 0x98BC febrero se mira aparte (bisiesto)
C 0x98C5 los dias del mes...
C 0x98C6 ...no pueden ser menos que el dia
C 0x98F5 cuenta los bits hasta el ultimo a 1
C 0x98F7 D = la posicion
C 0x993B la primera cifra...
C 0x9941 ...x 1000
C 0x9948 la segunda...
C 0x994E ...x 100
C 0x9955 sumadas
C 0x9957 la tercera...
C 0x995D ...x 10
C 0x9964 sumadas
C 0x9965 mas la cuarta
C 0x996B el numero a 0xE088
C 0x99AC B = 0: retroceso (BS)
C 0x99B4 1: flecha derecha (0x1C)
C 0x99BA 2: flecha izquierda (0x1D)
C 0x99C0 3: RETURN
C 0x99C5 4: una cifra
C 0x9A72 en la ultima cifra no hay cursor
C 0x9A74 la cifra del cursor...
C 0x9A7A ...su posicion en la pantalla (tabla de p05:9AA3)
C 0x9A83 la cifra que hay alli
C 0x9A87 C = la cifra
C 0x9A88 el parpadeo...
C 0x9A8B ...bit 6: encendido o apagado
C 0x9A8F apagado: la casilla de color 0xFF
C 0x9B25 guarda los registros
C 0x9B2A borra la casilla de la cifra
C 0x9B55 ninguna tecla
C 0x9B58 0x80: ...
C 0x9B5C 0x10: ...
C 0x9BF3 el dia mostrado en BCD (0xE04C, 0xE04D)
C 0x9BFA las decenas
C 0x9BFE las unidades: 1...
C 0x9C03 ...o 0
C 0x9C48 baja uno
C 0x9C4B llego a -C?
C 0x9C50 si no, lo guarda
C 0x9C52 A = 0
C 0x9C61 sube uno
C 0x9C63 llego a C?
C 0x9C66 si no, lo guarda
C 0x9C67 A = 0
C 0x9CF1 un angulo
C 0x9CF7 mas el adelanto de la tabla de IY
C 0x9D05 el siguiente (2 bytes)
C 0x9D0C los B ciclos
C 0x9DA5 B = el nivel: 0 desde 0xA0
C 0x9DAB 1 desde 0x90
C 0x9DB0 2 desde 0x80
C 0x9DB5 3 desde 0x70
C 0x9DBA 4 por debajo
C 0x9E02 H = la altura del fisico
C 0x9E05 D = la de la sensibilidad
C 0x9E08 B = la del intelecto
C 0x9E0B las letras de cada ciclo: 0x1B, 0x1C y 0x1D
C 0x9E11 pinta las marcas en la grafica (p06:A33D)
C 0x9E14 el primer valor...
C 0x9E17 ...al texto de p05:E441
C 0x9E1B el segundo
C 0x9E22 el tercero
C 0x9E29 y pinta los tres textos de p05:9EF9
C 0x9F84 una fila de la grafica
C 0x9F85 0xD0 bytes...
C 0x9F88 ...con el color 0xF0
C 0x9F90 la fila siguiente, 0x100 mas alla
C 0x9F94 las B filas
C 0x9F97 la linea de arriba de la grafica, a la derecha de 0x0A18...
C 0x9F9A ...0x1A casillas...
C 0x9F9C ...con el color 0xFF
C 0x9FA1 la linea del medio (0x1018), de puntos (0xCC)
C 0x9FAB la de abajo (0x1618)
C 0x9FB5 la de la izquierda (0x0919)...
C 0x9FBF ...y la de la derecha (0x1619)
C 0x9FC9 las marcas de la escala: 0xC0 en 0x0A18...
C 0x9FD3 ...0x10 en 0x0A58...
C 0x9FDD ...y 0x03 en 0x0AE0
# --- fin de lo escrito a mano ---

