# Notas del banco 05
# --- COMENTARIOS COPIADOS DE LAS GEMELAS (tools/gemelas.py; no editar a mano) ---
C 0x809F B tercios: copia a la VRAM
C 0x80A5 el tercio siguiente esta 0x800 mas alla
C 0x80AC los B tercios
C 0x80F1 HL = la direccion de VRAM que viene en el bloque
C 0x80FA el byte de cuenta
C 0x80FC 0 acaba
C 0x80FF n & 0x7F...
C 0x8101 ...si es el mismo, bit 7 a 0: repetir
C 0x8104 0x80: otra direccion de VRAM
C 0x8107 bit 7 a 1: copiar n bytes
C 0x8108 un byte...
C 0x810B ...a la VRAM
C 0x810E los n bytes
C 0x8130 BC bytes: B vueltas de 256...
C 0x8134 ...si C es 0, justas
C 0x8135 si no, una mas
C 0x817E el puerto de los registros (VDP.DW + 1)
C 0x8183 los dos bits altos de la direccion...
C 0x8189 ...a R#14
C 0x818F la parte baja
C 0x8192 y la alta con el bit de escritura (0x40)
C 0x82CA rojo y azul
C 0x82CC verde
C 0x82CF el color A
C 0x82D3 el siguiente
C 0x82D4 los B colores
C 0x8311 los puertos del VDP
C 0x8314 C = el de los registros
C 0x8318 el numero de registro de estado...
C 0x831A ...a R#15
C 0x831F lo lee
C 0x8322 y deja R#15 en 0
C 0x83C8 guarda el color
C 0x83C9 espera al VDP
C 0x83D2 R#17 = 36 (DX) con incremento
C 0x83DD DX = H
C 0x83E2 DY = L, en la pagina D
C 0x83E7 NX = B; 0 vale 256...
C 0x83ED ...y su parte alta
C 0x83F0 NY = C; 0 vale 256
C 0x83F6 y su parte alta
C 0x83F9 CLR = el color
C 0x83FC ARG a 0
C 0x83FE CMD = 0xC0: HMMV
C 0x8405 espera al VDP
C 0x8409 el puerto de los registros (VDP.DW + 1)
C 0x840E R#17 = 32 (SX) con incremento: los 15 registros del comando seguidos
C 0x8417 C = el puerto de registros indirectos (VDP.DW + 3)
C 0x8419 SX = H
C 0x841E SY = L...
C 0x8422 ...con la pagina de origen (A & 3)
C 0x8426 DX = D
C 0x842B DY = E...
C 0x842D ...con la pagina de destino ((A >> 2) & 3)
C 0x8434 NX = B (de la pila)
C 0x843A NY = C
C 0x843C CLR y ARG a 0
C 0x8442 CMD = 0xD0: HMMM
C 0x8673 dos pixeles al byte de destino
C 0x8676 los 4 pares
C 0x867A el byte siguiente
C 0x867C los 8 bytes
C 0x8697 una linea de la letra: 4 bytes (8 pixeles de 4 bits)
C 0x869F la linea siguiente esta 128 bytes mas abajo
C 0x86A5 las 8 lineas
C 0x86A8 la letra siguiente, 8 bytes mas alla
C 0x8725 la letra
C 0x8726 la columna (0-31) x 8: X
C 0x872C la fila (de 32 en 32) / 4: Y
C 0x8733 8 pixeles a la derecha
C 0x8737 si no da la vuelta, ya esta
C 0x8738 si la da, 8 pixeles mas abajo
C 0x9D62 en (0x30, 0x50)
C 0x9D6E en (0x3A, 0x50)
C 0x9D7A en (0x44, 0x50)
# --- fin de los comentarios copiados ---

