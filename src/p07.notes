# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8024 hl_mas_a HL = HL + A (gemela de p01:7251)
L 0x8029 de_mas_a DE = DE + A (gemela de p01:7256)
L 0x802E despacha salta a la palabra A de la tabla pegada detras del `call` (gemela de p01:737B)
L 0x806E th_sale_con_teclas si se pulsan a la vez las teclas de salida (SNSMAT 6 y 3), acaba el juego
L 0x8154 th_marcador_set pinta el SET y el 1ST/2ND/3RD (tenis: 0xE412 = 1)
L 0x822D th_esconde_sprites pone 0xE0 en la tabla de sprites (0x3B00)
L 0x831B th_texto_saque pinta el texto del saque segun 0xE41D
L 0x83A5 th_pinta_campo pinta las piezas del campo de la tabla de p07:83C6
L 0x83D2 th_pantalla_campo borra y pinta el campo (p07:83F5 en 0x38E8)
L 0x8495 th_borra_sprites pone 0xE0 en la copia de sprites (0xE500) y la vuelca
L 0x84A5 th_pinta_marcadores pinta el marcador entero
L 0x84B1 th_cabecera la cabecera del marcador: tenis (p07:84C6) o hockey (p07:8506)
L 0x8551 th_tanteo pinta los dos tanteos (0xE410 y 0xE411)
L 0x8562 th_tiempo en hockey, pinta el tiempo (0xE419)
L 0x8586 th_pinta_bcd pinta el byte BCD de DE en dos cifras grandes
L 0x8593 th_cifra_baja pinta la cifra baja del BCD de DE
L 0x8596 th_cifra pinta la cifra A con las dos letras de p07:85AD
L 0x85C1 th_divide desplaza HL y A: la posicion entre 8
L 0x85D5 th_borra_pantalla borra los sprites y la tabla de nombres
L 0x85E2 th_vram_escribe SETWRT en HL y C = el puerto de datos del VDP
L 0x85EE th_copia_a_vram LDIRVM de DE a HL
L 0x8605 th_rellena_tercios FILVRM en los tres tercios
L 0x8616 th_descomprime_tercios descomprime DE en los tres tercios
L 0x8626 th_pinta_texto pinta un texto: [direccion de VRAM][n][letras], letras + 0x20
L 0x8647 th_descomprime descomprime DE a la VRAM HL: n & 0x7F repeticiones o copias, 0 acaba
L 0x866C th_vuelca_sprites vuelca a la tabla de sprites la copia de 0xE500
L 0x86B0 th_inicia silencio, sonido 1, borra la VRAM y pone los 8 registros del VDP
L 0x86E2 th_lee_mandos lee los dos mandos y el teclado (0xE405-0xE408)
L 0x86FB th_recien_pulsado guarda lo pulsado y deja en A lo que se acaba de pulsar
L 0x8702 th_lee_puerto lee el puerto de mandos E (R#15 del PSG y R#14)
L 0x8712 th_teclas_1 las teclas del jugador 1 (SNSMAT 7 y 8)
L 0x873A th_teclas_2 las teclas del jugador 2 (SNSMAT 3...)
L 0x8823 th_fuente la fuente del minijuego (p07:885B en 0x2080) y su color
L 0x883A th_patrones los patrones del campo
L 0x898C th_partido prepara el partido: tenis (p07:95BC) o hockey (p07:987C)
L 0x89D3 th_cuadro un cuadro del partido: jugadores, pelota, marcador y sprites
L 0x89F6 th_jugador_1 prepara al jugador 1 (0xE421)
L 0x8A55 th_jugador_2 prepara al jugador 2 (0xE431)
L 0x8AE1 th_mueve_jugador_1 mueve al jugador 1 segun su mando
L 0x8B2C th_direccion_1 la direccion del mando del jugador 1
L 0x8B58 th_mueve_jugador_2 mueve al jugador 2 segun su mando
L 0x8BA3 th_direccion_2 la direccion del mando del jugador 2
L 0x8BD7 th_sprites_jugadores los sprites de los dos jugadores a la copia de 0xE500
L 0x8C17 th_sprite_raqueta escribe los sprites de una raqueta (C de alto)
L 0x8C4D th_prepara_disco prepara el disco del hockey (0xE450)
L 0x8C62 th_mueve_disco mueve el disco del hockey
L 0x8C86 th_sprite_disco el sprite del disco del hockey
L 0x8CB9 th_prepara_pelota la pelota al centro (0xE440)
L 0x8CF2 th_mueve_pelota mueve la pelota y mira los choques
L 0x8D38 th_avanza_pelota suma la velocidad a la posicion de la pelota (0xE440, 0xE442)
L 0x8D63 th_velocidad la velocidad de la pelota segun SPEED (0xE413)
L 0x8D84 th_choques los choques de la pelota con las raquetas
L 0x8DFE th_efecto el efecto que da la raqueta a la pelota
L 0x8E44 th_choque comprueba un choque de la pelota
L 0x8F72 th_choca_raqueta mira si la pelota toca una raqueta
L 0x8FCA th_choca_borde mira si la pelota toca el borde de la raqueta
L 0x9007 th_dentro_porteria mira si la pelota entra en la porteria
L 0x902C th_sprite_pelota el sprite de la pelota a la copia de 0xE500
L 0x9040 th_velocidades las dos velocidades de las tablas de p07:9051 y p07:9059
L 0x9079 palabra_de_tabla DE = la palabra A de la tabla de DE
L 0x9082 th_campo_tenis descomprime p07:9386 en 0x2300
L 0x908B th_campo_hockey descomprime p07:951D en 0x0300
L 0x9094 th_campo_colores descomprime p07:9535
L 0x909A th_menu_juego GAME SELECT: TENNIS / HOCKEY / END
L 0x90A6 th_elige_juego mueve la eleccion de juego (0xE412) con el mando
L 0x9100 th_menu_modify GAME MODIFY: LENGTH / SPEED / TYPE / BAR
L 0x9136 th_cambia_opcion cambia la opcion elegida del GAME MODIFY (0xE460)
L 0x91F5 th_pon_palabra escribe en HL la palabra A de la tabla y vuelca los sprites
L 0x9230 th_aplica_opciones copia LENGTH, SPEED, TYPE y BAR (0xE461...) a 0xE413...
L 0x9277 th_tanto suma el tanto al jugador que toca
L 0x931A th_reloj en hockey, baja el tiempo (0xE419, BCD) cada 64 cuadros
L 0x935D th_gol mira si la pelota sale por un lado y de quien es el tanto
L 0x9B3C pide_sonido pide el sonido A al motor (con las interrupciones cerradas)
L 0x9B52 pide_sonido_b pone en sus canales las pistas del sonido A (tabla de p07:9BF5)
L 0x9BCB canal_libre pone la pista en el canal si su prioridad no es menor
L 0x9CA5 sonido_cuadro el motor de sonido: un cuadro de los cinco canales
L 0x9CDF canal_cuadro un cuadro del canal IX si esta activo
L 0x9CE7 canal_nota baja la duracion; si acaba, lee la orden siguiente de la pista
L 0x9CF3 canal_ordenes lee las ordenes de la pista (0xD0-0xFE) hasta una nota; 0xFF acaba
L 0x9D1C canal_duracion la duracion de la nota: la parte baja por el tempo (ix+0x14)
L 0x9E01 canal_bucle repeticion: guarda donde vuelve (ix+0x17)
L 0x9E22 canal_empieza_nota empieza la nota: frecuencia y envolvente a cero
L 0x9E6B a_cero A = 0 y Z
L 0x9EB1 canal_frecuencia la frecuencia de la nota (ix+0x10) con el desplazamiento (ix+0x26) a (ix+0x0A)
L 0x9ECE canal_vibrato el contador del vibrato (ix+0x1E) segun los bits de (ix+0x0E)
L 0x9F23 canal_volumen_si el volumen del canal salvo si (ix+0x0D) lleva el bit 2
L 0x9F2F canal_volumen el volumen del canal segun la envolvente de (ix+0x0F)
L 0x9FB9 canal_avanza avanza el puntero de la pista (ix+0x02)
L 0x9FFB th_9ffb HL = 0xE2F6 y sigue en p08
