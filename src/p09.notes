# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8000 engancha_cuenta pone en H.KEYI (0xFD9A) la cuenta atras de 0xE008 (p09:800E)
L 0x8013 desengancha_cuenta devuelve H.KEYI a `ret`
L 0x801B titulo_empieza engancha la cuenta, mira MSX1/MSX2 y el juego de caracteres, y pinta
L 0x8043 titulo_empieza_b mira MSX1/MSX2 y el juego de caracteres, engancha la cuenta y pinta
L 0x80D2 titulo_si_msx1 en MSX1, la presentacion de MSX1
L 0x8117 titulo_espera anima la presentacion hasta que se pulsa una tecla
L 0x8133 nada_9133 `ret`
L 0x8134 nada_9134 `ret`
L 0x8135 titulo_msx1 la presentacion en MSX1: descomprime p09:9988 y pinta
L 0x8163 titulo_letras dibuja tres rotulos de letras de 1 bit (p09:9B6A, 9BD2, 9C3A)
L 0x8191 titulo_graficos los patrones, los colores y la fuente de la presentacion
L 0x819B titulo_colores los colores y los patrones del rotulo en MSX1
L 0x81D2 titulo_patrones descomprime p09:81DB en los tres tercios
L 0x823D fuente_a_vram la fuente de p00:483F a la VRAM 0x2180 y su color 0xF0
L 0x8254 titulo_anima la animacion de la presentacion (0xE001)
L 0x82AA pinta_lista_de_letras pinta una lista de letras [n, letras]; 0xFF acaba, 0xFE salta
L 0x82CA titulo_dibuja dibuja la presentacion (p09:9DE3 y p10:A1E3)
L 0x8457 copia_filas_a_vram copia B filas de C bytes a la VRAM, una fila de 32 de paso
L 0x846D titulo_menu_bucle el bucle del menu de la presentacion: espera, flechas y espacio
L 0x84C8 espera_tecla_animando anima hasta que se pulsa una tecla
L 0x84D9 titulo_paso un paso de la animacion de la presentacion (0xE020)
L 0x84FA titulo_cuadro un cuadro de la animacion: cada vez que cambia la cuenta (0xE008)
L 0x85CB flecha 0x1E arriba, 0x1F abajo
L 0x861A titulo_menu el menu de la presentacion
L 0x86A8 borra_vram_32k BIGFIL de 0x8000 bytes desde 0
L 0x86B3 titulo_sprites los sprites del rotulo en MSX2 (p09:9D0A a 0xF800)
L 0x86C8 titulo_rotulos_msx2 pinta los dos rotulos de p09:9828 y p09:98A0
L 0x86E1 pinta_letras_8x8 pinta B letras de 8x8 desde HL (p09:8F7D)
L 0x86F8 titulo_paleta el color 7 del fondo (R#7) y la paleta de p09:8706
L 0x8731 titulo_dibujos descomprime p09:8C00 y p09:8800 en la VRAM 0xA580 y 0xA390
L 0x8744 descomprime_128k descomprime HL a la VRAM DE de 128 KB: n & 0x7F repeticiones
L 0x8775 siguiente_fila_128k pasa a la fila siguiente cada 32 bytes
L 0x8846 titulo_rotulo el rotulo de la presentacion en MSX1 (p09:9048)
L 0x8894 esconde_sprites pone 0xE0 en la tabla de sprites (0x3B00)
L 0x8B32 espera_espacio espera la barra espaciadora
L 0x8B3D dibujo_del_banco_11 pone el banco 11 en 0xA000, descomprime p11:A000 y vuelve al 10
L 0x8B51 titulo_pinta_msx2 pinta la presentacion en MSX2
L 0x8B8E titulo_paleta_b el color 4 del fondo y la paleta de p09:8B9C
L 0x8D27 titulo_msx1_b la presentacion en MSX1: fuente, colores y texto
L 0x8D83 copia_filas_a_vram_b copia B filas de C bytes a la VRAM, una fila de 32 de paso
L 0x8DEE cuenta_otir A y B para un OTIR de BC bytes
L 0x8DF6 escribe_vram_otir escribe BC bytes de HL en la VRAM DE con OTIR
L 0x8E09 vram_situa_128k pone la direccion de 17 bits de la VRAM (R#14 y la direccion)
L 0x8E28 espera_vdp espera a que el VDP acabe el comando (bit 0 de S#2)
L 0x8E32 lee_estado_vdp lee el registro de estado A del VDP (R#15) y vuelve a S#0
L 0x8E52 vdp_hmmm copia rapida de VRAM a VRAM (HMMM): origen HL, destino DE, tamano BC, paginas en A
L 0x8E96 letra_8x8_en_pagina_1 copia la letra A de 8x8 dentro de la pagina 1 (HMMM)
L 0x8EA8 letra_a_coordenadas H, L = la columna y la fila de la letra A en la hoja de letras
L 0x8EB6 pantalla_encendida R#1 con el bit 6 (pantalla encendida) y R#8 sin el bit 1
L 0x8EC1 sprites_encendidos R#8 sin el bit 1: con sprites
L 0x8ECC pantalla_apagada R#1 sin el bit 6 y R#8 con el bit 1
L 0x8ED7 sprites_apagados R
L 0x8EE2 letras_1bit_a_4bit pinta B letras de 1 bit en SCREEN 5 (4 bits)
L 0x8EEB letra_1bit_a_4bit pasa una letra de 1 bit a 4 bits (0xE100) y la escribe
L 0x8F1B letra_expande expande los 8 bytes de la letra a 32 con el color C
L 0x8F41 vdp_hmmv rellena un rectangulo de VRAM (HMMV, comando 0xC0)
L 0x8F7D letra_8x8_a_pagina_0 copia la letra A de 8x8 de la pagina 1 a la 0 (HMMM)
L 0x8F8F pinta_letra_8x8 copia la letra A de 8x8 de la hoja de letras a DE (LMMM) (gemela de p05:86FC)
L 0x8FA1 vdp_lmmm copia de VRAM a VRAM con operacion logica (LMMM, 0x90 | op)
L 0x903E siguiente_letra D += 8; al pasar de fila, E += 8
C 0x8004 apunta a el gancho H.KEYI
C 0x800E apunta a la cuenta atras de la interrupcion
C 0x8016 guarda el gancho H.KEYI
C 0x801B engancha_cuenta: pone en H.KEYI (0xFD9A) la cuenta atras de 0xE008 (p09:800E)
C 0x801E la version del MSX (0 = MSX1)
C 0x8021 guarda es un MSX2
C 0x8024 el juego de caracteres y la frecuencia de la BIOS
C 0x8029 guarda el juego de caracteres de la BIOS (0x002B)
C 0x802F guarda es un MSX2
C 0x8032 lee es un MSX2
C 0x803A guarda el color del borde (BDRCLR)
C 0x8043 la version del MSX (0 = MSX1)
C 0x8046 guarda es un MSX2
